                  "styles": {
                    "icon": [
                      {
                        "color": "{% if is_state('sensor.electrolux_washing_machine_appliancestate', 'off') %}\n  grey\n{% elif is_state('sensor.electrolux_washing_machine_appliancestate', 'Ready to Start') %}\n  blue\n{% elif is_state('sensor.electrolux_washing_machine_appliancestate', 'Running') %}\n  green\n{% else %}\n  grey\n{% endif %}\n"
                      }
                    ]
                  },
                  "secondary": "{{ states('sensor.electrolux_washing_machine_appliancestate') }}"
