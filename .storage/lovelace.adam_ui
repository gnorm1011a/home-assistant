                          "secondary": "  {% set last_changed = as_timestamp(states.binary_sensor.doorbell_visitor_2.last_changed) %}\n  {% set now = as_timestamp(now()) %}\n  {% set time_diff = now - last_changed %}\n  {% if time_diff < 60 %}\n    {{ time_diff | int }} second{{ 's' if time_diff | int != 1 else '' }} ago\n  {% elif time_diff < 3600 %}\n    {{ (time_diff / 60) | int }} minute{{ 's' if (time_diff / 60) | int != 1 else '' }} ago\n  {% else %}\n    {{ (time_diff / 3600) | int }} hour{{ 's' if (time_diff / 3600) | int != 1 else '' }} ago\n  {% endif %}",
