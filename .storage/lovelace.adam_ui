{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.adam_ui",
  "data": {
    "config": {
      "title": "Park Place",
      "views": [
        {
          "badges": [],
          "cards": [],
          "icon": "mdi:home-outline",
          "title": "Home",
          "type": "sections",
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "weather-forecast",
                  "entity": "weather.abbotsford",
                  "show_forecast": false
                },
                {
                  "color": "orange",
                  "type": "tile",
                  "entity": "input_select.house_mode",
                  "grid_options": {
                    "columns": 12,
                    "rows": 1
                  }
                },
                {
                  "type": "horizontal-stack",
                  "cards": [
                    {
                      "type": "tile",
                      "name": "Adam",
                      "entity": "person.adam_smith",
                      "show_entity_picture": true
                    },
                    {
                      "type": "tile",
                      "name": "Mads",
                      "entity": "person.madeleine_moloney",
                      "show_entity_picture": true
                    },
                    {
                      "type": "custom:mushroom-entity-card",
                      "entity": "binary_sensor.mew_meow",
                      "name": "Mewy",
                      "hold_action": {
                        "action": "more-info"
                      },
                      "tap_action": {
                        "action": "perform-action",
                        "perform_action": "script.toggle_cat_location",
                        "target": {}
                      }
                    }
                  ]
                },
                {
                  "type": "heading",
                  "heading": "Scenes",
                  "heading_style": "title",
                  "icon": "mdi:palette"
                },
                {
                  "square": false,
                  "columns": 3,
                  "type": "grid",
                  "cards": [
                    {
                      "color": "indigo",
                      "type": "tile",
                      "entity": "input_boolean.movie_mode",
                      "tap_action": {
                        "action": "toggle"
                      }
                    },
                    {
                      "color": "lime",
                      "type": "tile",
                      "entity": "input_boolean.casual_dining",
                      "tap_action": {
                        "action": "toggle"
                      },
                      "name": "Dining"
                    },
                    {
                      "color": "cyan",
                      "type": "tile",
                      "entity": "input_boolean.tv",
                      "tap_action": {
                        "action": "toggle"
                      }
                    },
                    {
                      "color": "blue",
                      "type": "tile",
                      "entity": "input_boolean.bedtime",
                      "tap_action": {
                        "action": "toggle"
                      }
                    },
                    {
                      "color": "yellow",
                      "type": "tile",
                      "entity": "input_boolean.outdoor",
                      "tap_action": {
                        "action": "toggle"
                      }
                    },
                    {
                      "color": "amber",
                      "type": "tile",
                      "entity": "input_boolean.dishwashing",
                      "tap_action": {
                        "action": "toggle"
                      }
                    },
                    {
                      "type": "custom:mushroom-entity-card",
                      "entity": "input_boolean.excercise_mode",
                      "name": "Excercise",
                      "icon_color": "deep-purple"
                    }
                  ]
                },
                {
                  "type": "heading",
                  "icon": "mdi:motion-sensor",
                  "heading": "Security",
                  "heading_style": "title"
                },
                {
                  "features": [
                    {
                      "type": "alarm-modes",
                      "modes": [
                        "armed_home",
                        "armed_away",
                        "armed_night",
                        "armed_vacation",
                        "disarmed"
                      ]
                    }
                  ],
                  "color": "light-green",
                  "type": "tile",
                  "entity": "alarm_control_panel.alarmo",
                  "grid_options": {
                    "columns": 12,
                    "rows": 2
                  }
                },
                {
                  "type": "custom:auto-entities",
                  "card": {
                    "type": "entities"
                  },
                  "filter": {
                    "include": [
                      {
                        "domain": "binary_sensor",
                        "attributes": {
                          "device_class": "motion"
                        },
                        "state": "on",
                        "options": {
                          "secondary_info": "last-changed"
                        }
                      }
                    ],
                    "exclude": [
                      {
                        "entity_id": "binary_sensor.bda90a91_536107e5"
                      },
                      {
                        "entity_id": "binary_sensor.90f2526b_0a6cc42e"
                      }
                    ]
                  },
                  "sort": {
                    "method": "last_changed",
                    "reverse": true,
                    "count": 6
                  }
                },
                {
                  "type": "heading",
                  "heading": "Energy",
                  "heading_style": "title",
                  "icon": "mdi:home-lightning-bolt"
                },
                {
                  "square": false,
                  "columns": 2,
                  "type": "grid",
                  "cards": [
                    {
                      "type": "custom:mushroom-template-card",
                      "entity": "sensor.mains_power_power",
                      "primary": "Mains Power",
                      "secondary": "{{ (states('sensor.mains_power_power') | float(0) / 1000) | round(2) }} kW",
                      "icon": "mdi:transmission-tower",
                      "icon_color": "{{ 'green' if (states('sensor.mains_power_power') | float(0)) < 1000 else 'orange' }}"
                    },
                    {
                      "type": "custom:mushroom-entity-card",
                      "entity": "sensor.mains_power_energy",
                      "name": "Today's Consumption "
                    },
                    {
                      "type": "custom:mushroom-template-card",
                      "entity": "sensor.solax_a32b797b_power_now",
                      "primary": "Current Solar",
                      "secondary": "{{ (states('sensor.solax_a32b797b_power_now') | float(0) / 1000) | round(2) }} kW",
                      "icon": "mdi:solar-power",
                      "icon_color": "accent"
                    },
                    {
                      "type": "custom:mushroom-entity-card",
                      "name": "Today's Solar",
                      "icon_color": "purple",
                      "entity": "sensor.solax_a32b797b_today_s_energy",
                      "icon": "mdi:solar-power-variant"
                    },
                    {
                      "type": "custom:mushroom-entity-card",
                      "entity": "sensor.mains_power_energy_returned",
                      "name": "Energy Returned",
                      "icon": "mdi:current-ac"
                    }
                  ]
                },
                {
                  "type": "heading",
                  "icon": "mdi:delete-empty",
                  "heading": "Waste",
                  "heading_style": "title"
                },
                {
                  "square": false,
                  "type": "grid",
                  "cards": [
                    {
                      "type": "custom:mushroom-template-card",
                      "entity": "sensor.green_waste_days",
                      "primary": "Green",
                      "secondary": "{{ states('sensor.green_waste_days') }}",
                      "icon": "mdi:carrot",
                      "icon_color": "green",
                      "tap_action": {
                        "action": "none"
                      },
                      "hold_action": {
                        "action": "none"
                      },
                      "double_tap_action": {
                        "action": "none"
                      },
                      "primary_info": "name"
                    },
                    {
                      "type": "custom:mushroom-template-card",
                      "primary": "Recylcing",
                      "secondary": "{{ states('sensor.recycling_days') }}",
                      "icon": "mdi:bottle-soda-classic",
                      "icon_color": "yellow",
                      "entity": "sensor.recycling_days"
                    },
                    {
                      "type": "custom:mushroom-template-card",
                      "entity": "sensor.general_waste_days",
                      "primary": "General",
                      "secondary": "{{ states('sensor.general_waste_days') }}",
                      "icon": "mdi:trash-can",
                      "icon_color": "red",
                      "tap_action": {
                        "action": "none"
                      },
                      "hold_action": {
                        "action": "none"
                      },
                      "double_tap_action": {
                        "action": "none"
                      },
                      "primary_info": "name"
                    },
                    {
                      "type": "custom:mushroom-template-card",
                      "primary": "Glass",
                      "secondary": "{{ states('sensor.glass_days') }}",
                      "icon": "mdi:bottle-soda-classic",
                      "icon_color": "purple",
                      "entity": "sensor.glass_days"
                    }
                  ],
                  "columns": 2
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "icon": "mdi:balloon",
                  "heading": "Events",
                  "heading_style": "title"
                },
                {
                  "type": "custom:atomic-calendar-revive",
                  "enableModeChange": true,
                  "entities": [
                    {
                      "entity": "sensor.calendars",
                      "icon": null
                    },
                    {
                      "entity": "calendar.birthdays",
                      "name": "Birthdays",
                      "icon": null
                    },
                    {
                      "entity": "calendar.personal_events",
                      "name": "Personal Events",
                      "icon": null
                    }
                  ],
                  "maxDaysToShow": 365,
                  "maxEventCount": 8,
                  "showDeclined": false,
                  "hideFinishedEvents": true,
                  "showDate": false,
                  "showProgressBar": false,
                  "showWeekDay": true,
                  "disableEventLink": false,
                  "showDescription": false,
                  "showMonth": true,
                  "showCurrentEventLine": false,
                  "showFullDayProgress": false,
                  "showNoEventsForToday": false,
                  "showCalendarName": false,
                  "showEventDate": true,
                  "showWeekNumber": false,
                  "showTimeRemaining": false,
                  "showDatePerEvent": true,
                  "dimFinishedEvents": true,
                  "compactMode": false,
                  "showEventIcon": true,
                  "showAllDayHours": false,
                  "hoursOnSameLine": false,
                  "showAllDayEvents": true,
                  "offsetHeaderDate": false,
                  "allDayBottom": false,
                  "showRelativeTime": true,
                  "disableLocationLink": false,
                  "showHiddenText": false,
                  "showLocation": false,
                  "showLoader": false,
                  "showColors": false,
                  "card_mod": {
                    "style": ".event-left {\n  font-size:12px !important;\n}\n.event-title {\n  font-size: 15px !important;\n}\n.hours {\n  font-size: 12px !important;\n}\n.event-location {\n  font-size: 16px !important;\n}\n.hours {\n  font-size: 12px !important;\n}\n .relative-time {\n  font-size: 12px !important;\n}\n"
                  }
                },
                {
                  "square": false,
                  "columns": 2,
