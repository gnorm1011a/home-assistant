        {
          "title": "Cat",
          "path": "cat",
          "icon": "mdi:cat",
          "badges": [],
          "cards": [
            {
              "type": "custom:stack-in-card",
              "cards": [
                {
                  "type": "custom:mushroom-template-card",
                  "entity": "sensor.mew_meow_position",
                  "icon": "{% if is_state('sensor.mew_meow_position', 'inside') %}\n  mdi:cat\n{% else %}\n  mdi:flower\n{% endif %}\n",
                  "icon_color": "{% if is_state('sensor.mew_meow_position', 'inside') %}\n  blue\n{% else %}\n  green\n{% endif %}\n",
                  "primary": "Mew-Meow",
                  "secondary": "{% if is_state('sensor.mew_meow_position', 'inside') %}\n  Home (Inside for {{ relative_time(states.sensor.mew_meow_position.last_changed) }})\n{% else %}\n  Away (Outside for {{ relative_time(states.sensor.mew_meow_position.last_changed) }})\n{% endif %}\n",
                  "card_mod": {
                    "style": "ha-card {\n  padding-bottom: 10px !important;\n  transform: scale(1.25);\n  transform-origin: top left;\n}\n"
                  }
                },
                {
                  "type": "custom:mushroom-entity-card",
                  "entity": "sensor.mew_meow_position",
                  "name": "Mewy",
                  "hold_action": {
                    "action": "more-info"
                  },
                  "tap_action": {
                    "action": "perform-action",
                    "perform_action": "script.toggle_cat_location",
                    "target": {}
                  },
                  "card_mod": {
                    "style": "mushroom-state-item {\n  display: none;\n}\nha-card {\n  transform: scale(1.25);\n  transform-origin: top left;\n}\n"
                  }
                }
              ],
              "card_mod": {
                "style": "ha-card {\n  box-shadow: none;\n  --ha-card-border-width: 0px;\n  width: 100%;\n  height: 125%;\n}\n"
              }
            },
            {
              "square": false,
              "type": "grid",
              "columns": 2,
              "cards": [
                {
                  "type": "custom:mushroom-template-card",
                  "entity": "sensor.mew_meow_entries",
                  "primary": "Number of Entries",
                  "secondary": "{{ states('sensor.mew_meow_entries') }}\n",
                  "icon": "mdi:counter",
                  "tap_action": {
                    "action": "more-info"
                  }
                },
                {
                  "type": "custom:mushroom-template-card",
                  "entity": "sensor.duration_outside_formatted",
                  "primary": "Duration Outside",
                  "secondary": "{{ states('sensor.duration_outside_formatted') }}\n",
                  "icon": "mdi:clock-outline",
                  "tap_action": {
                    "action": "more-info"
                  }
                },
                {
                  "type": "custom:mushroom-template-card",
                  "entity": "sensor.duration_inside_formatted",
                  "primary": "Duration Inside",
                  "secondary": "{{ states('sensor.duration_inside_formatted') }}\n",
                  "icon": "mdi:clock-outline",
                  "tap_action": {
                    "action": "more-info"
                  }
                },
                {
                  "type": "custom:mushroom-template-card",
                  "entity": "sensor.avg_outside_formatted",
                  "primary": "Avg Time Outside (Last 7 Days)",
                  "secondary": "{{ states('sensor.avg_outside_formatted') }}\n",
                  "icon": "mdi:calendar-clock",
                  "tap_action": {
                    "action": "more-info"
                  }
                }
              ]
            },
            {
              "type": "entities",
              "entities": [
                {
                  "entity": "input_select.cat_chart_range",
                  "name": "Chart range"
                }
              ],
              "card_mod": {
                "style": "ha-card {\n  box-shadow: none;\n  --ha-card-border-width: 0px;\n  padding: 0px 8px;\n}\n"
              }
            },
            {
              "type": "custom:state-switch",
              "entity": "input_select.cat_chart_range",
              "states": {
                "7 Days": {
                  "type": "custom:apexcharts-card",
                  "graph_span": "7d",
                  "span": {
                    "end": "day"
                  },
                  "stacked": true,
                  "header": {
                    "show": true,
                    "title": "Cat Inside vs Outside (Last 7 Days)",
                    "show_states": true,
                    "colorize_states": true
                  },
                  "yaxis": [
                    {
                      "id": "main-axis",
                      "min": 0,
                      "max": 24,
                      "decimals": 0
                    }
                  ],
                  "series": [
                    {
                      "entity": "sensor.mew_meow_duration_inside",
                      "yaxis_id": "main-axis",
                      "type": "column",
                      "name": "Inside",
                      "color": "#4CAF50",
                      "stack_group": "cat_duration",
                      "group_by": {
                        "func": "max",
                        "duration": "1d"
                      },
                      "show": {
                        "as_duration": "hour",
                        "legend_value": true
                      }
                    },
                    {
                      "entity": "sensor.mew_meow_duration_outside",
                      "yaxis_id": "main-axis",
                      "type": "column",
                      "name": "Outside",
                      "color": "#FF9800",
                      "stack_group": "cat_duration",
                      "group_by": {
                        "func": "max",
                        "duration": "1d"
                      },
                      "show": {
                        "as_duration": "hour",
                        "legend_value": true
                      }
                    }
                  ],
                  "apex_config": {
                    "chart": {
                      "stacked": true,
                      "stackType": "normal"
                    },
                    "plotOptions": {
                      "bar": {
                        "columnWidth": "70%"
                      }
                    },
                    "datalabels": {
                      "enabled": false
                    },
                    "legend": {
                      "position": "top"
                    }
                  }
                },
                "30 Days": {
                  "type": "custom:apexcharts-card",
                  "graph_span": "30d",
                  "span": {
                    "end": "day"
                  },
                  "stacked": true,
                  "header": {
                    "show": true,
                    "title": "Cat Inside vs Outside (Last 30 Days)",
                    "show_states": true,
                    "colorize_states": true
                  },
                  "yaxis": [
                    {
                      "id": "main-axis",
                      "min": 0,
                      "max": 24,
                      "decimals": 0
                    }
                  ],
                  "series": [
                    {
                      "entity": "sensor.mew_meow_duration_inside",
                      "yaxis_id": "main-axis",
                      "type": "column",
                      "name": "Inside",
                      "color": "#4CAF50",
                      "stack_group": "cat_duration",
                      "group_by": {
                        "func": "max",
                        "duration": "1d"
                      },
                      "show": {
                        "as_duration": "hour",
                        "legend_value": true
                      }
                    },
                    {
                      "entity": "sensor.mew_meow_duration_outside",
                      "yaxis_id": "main-axis",
                      "type": "column",
                      "name": "Outside",
                      "color": "#FF9800",
                      "stack_group": "cat_duration",
                      "group_by": {
                        "func": "max",
                        "duration": "1d"
                      },
                      "show": {
                        "as_duration": "hour",
                        "legend_value": true
                      }
                    }
                  ],
                  "apex_config": {
                    "chart": {
                      "stacked": true,
                      "stackType": "normal"
                    },
                    "plotOptions": {
                      "bar": {
                        "columnWidth": "90%"
                      }
                    },
                    "datalabels": {
                      "enabled": false
                    },
                    "legend": {
                      "position": "top"
                    }
                  }
                },
                "By Month": {
                  "type": "custom:apexcharts-card",
                  "graph_span": "365d",
                  "span": {
                    "end": "month"
                  },
                  "stacked": true,
                  "header": {
                    "show": true,
                    "title": "Cat Inside vs Outside (Monthly Average)",
                    "show_states": true,
                    "colorize_states": true
                  },
                  "yaxis": [
                    {
                      "id": "main-axis",
                      "min": 0,
                      "max": 24,
                      "decimals": 1
                    }
                  ],
                  "series": [
                    {
                      "entity": "sensor.mew_meow_duration_inside",
                      "yaxis_id": "main-axis",
                      "type": "column",
                      "name": "Inside",
                      "color": "#4CAF50",
                      "stack_group": "cat_duration",
                      "statistics": {
                        "type": "mean",
                        "period": "month"
                      },
                      "show": {
                        "as_duration": "hour",
                        "legend_value": true
                      }
                    },
                    {
                      "entity": "sensor.mew_meow_duration_outside",
                      "yaxis_id": "main-axis",
                      "type": "column",
                      "name": "Outside",
                      "color": "#FF9800",
                      "stack_group": "cat_duration",
                      "statistics": {
                        "type": "mean",
                        "period": "month"
                      },
                      "show": {
                        "as_duration": "hour",
                        "legend_value": true
                      }
                    }
                  ],
                  "apex_config": {
                    "chart": {
                      "stacked": true,
                      "stackType": "normal"
                    },
                    "plotOptions": {
                      "bar": {
                        "columnWidth": "60%"
                      }
                    },
                    "datalabels": {
                      "enabled": false
                    },
                    "legend": {
                      "position": "top"
                    },
                    "xaxis": {
                      "labels": {
                        "datetimeFormatter": {
                          "month": "MMM yy"
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "history-graph",
              "title": "Today's Timeline",
              "hours_to_show": 24,
              "entities": [
                {
                  "entity": "binary_sensor.mew_meow",
                  "name": "Mew-Meow"
                }
              ]
            },
            {
              "type": "markdown",
              "title": "Today's Trips",
              "content": "{% set s = 'sensor.surepetcare_flap_stats' %}\n{% set trips = state_attr(s, 'trips_today') %}\n{% if trips %}\n**{{ trips | length }} trips out** - {{ state_attr(s, 'time_outside_today_mins') }} min outside in total\n\n| Out | In | Duration |\n|---|---|---|\n{% for t in trips -%}\n| {{ as_timestamp(t.from) | timestamp_custom('%H:%M') }} | {{ as_timestamp(t.to) | timestamp_custom('%H:%M') }} | {{ t.duration_mins }} min |\n{% endfor %}\n{% else %}\nNo trips outside today.\n{% endif %}\n"
            },
            {
              "type": "vertical-stack",
              "cards": [
                {
                  "type": "grid",
                  "square": false,
                  "cards": [
                    {
                      "type": "custom:mushroom-template-card",
                      "entity": "binary_sensor.fresh_element_mini_food_level",
                      "icon": "{% if is_state('binary_sensor.fresh_element_mini_food_level', 'off') %}\n  mdi:food-drumstick\n{% elif is_state('binary_sensor.fresh_element_mini_food_level', 'problem') %}\n  mdi:food-drumstick-off\n{% endif %}\n",
                      "icon_color": "{% if is_state('binary_sensor.fresh_element_mini_food_level', 'off') %}\n  yellow\n{% elif is_state('binary_sensor.fresh_element_mini_food_level', 'problem') %}\n  red\n{% endif %}\n",
                      "primary": "Food Status",
                      "secondary": "{% if is_state('binary_sensor.fresh_element_mini_food_level', 'off') %}\n  Ok\n{% elif is_state('binary_sensor.fresh_element_mini_food_level', 'problem') %}\n  Low Food\n{% endif %}\n"
                    },
                    {
                      "type": "custom:mushroom-template-card",
                      "entity": "sensor.fresh_element_mini_status",
                      "icon": "{% if is_state('sensor.fresh_element_mini_status', 'normal') %}\n  mdi:cloud\n{% elif is_state('sensor.fresh_element_mini_status', 'offline') %}\n  mdi:alert-circle\n{% endif %}\n",
                      "icon_color": "{% if is_state('sensor.fresh_element_mini_status', 'normal') %}\n  blue\n{% elif is_state('sensor.fresh_element_mini_status', 'offline') %}\n  red\n{% endif %}\n",
                      "primary": "Connectivity",
                      "secondary": "{% if is_state('sensor.fresh_element_mini_status', 'normal') %}\n  Connected\n{% elif is_state('sensor.fresh_element_mini_status', 'offline') %}\n  Not Connected\n{% endif %}\n"
                    },
                    {
                      "type": "custom:mushroom-template-card",
                      "entity": "sensor.fresh_element_mini_error",
                      "icon": "{% if is_state('sensor.fresh_element_mini_error', 'no_error') %}\n  mdi:check-circle\n{% elif is_state('sensor.fresh_element_mini_error', 'error') %}\n  mdi:alert-circle\n{% endif %}\n",
                      "icon_color": "{% if is_state('sensor.fresh_element_mini_error', 'no_error') %}\n  green\n{% elif is_state('sensor.fresh_element_mini_error', 'error') %}  \n  red\n{% endif %}\n",
                      "secondary": "{% if is_state('sensor.fresh_element_mini_error', 'no_error') %}\n  No Errors\n{% elif is_state('sensor.fresh_element_mini_error', 'error') %}\n  Error\n{% endif %}\n",
                      "primary": "Status"
                    }
                  ]
                },
                {
                  "type": "entities",
                  "entities": [
                    {
                      "entity": "select.fresh_element_mini_manual_feed",
                      "name": "Manual feed",
                      "icon": "mdi:bowl-mix"
                    }
                  ]
